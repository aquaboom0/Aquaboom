# AquaRush Backend Environment Variables
# Copy this file to .env and fill in your values

# ==================== SERVER ====================
PORT=5000
NODE_ENV=development
# Optional rate limits (window is milliseconds). Defaults are tuned for mobile polling screens.
# RATE_LIMIT_WINDOW_MS=900000
# API_RATE_LIMIT_MAX=1200
# AUTH_RATE_LIMIT_MAX=120

# ==================== DATABASE ====================
# Local dev (MongoDB must be running): mongodb://127.0.0.1:27017/aquaboom
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/aquaboom?retryWrites=true&w=majority

# ==================== JWT ====================
JWT_SECRET=your-super-secret-jwt-key-change-in-production
# Optional: defaults to JWT_SECRET if omitted
JWT_REFRESH_SECRET=your-refresh-secret-or-same-as-jwt
JWT_EXPIRES_IN=7d

# ==================== ADMIN LOGIN ====================
# Used for /api/auth/admin/login in the unified mobile app.
ADMIN_USERNAME=admin@aquarush.com
ADMIN_PASSWORD=admin123
ADMIN_SECRET_KEY=aquarush_admin_2024

# ==================== RAZORPAY ====================
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# ==================== FIREBASE ====================
# Must be the SAME Firebase project as customer-app android/app/google-services.json (same project_id).
# Option 1: put the downloaded key next to backend package.json:
#   cp ~/Downloads/your-project-firebase-adminsdk-....json backend/firebase-service-account.json
# Option 2: custom path
# FIREBASE_SERVICE_ACCOUNT_PATH=/absolute/path/to/firebase-adminsdk.json
# Option 3: entire JSON as one line (secrets managers / hosting env). private_key must keep \n as \\n inside the string.
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# Console → Build → Realtime Database → copy the full https URL (regional URLs use *.firebasedatabase.app).
# Omit if you only use Cloud Messaging — required for syncing rider GPS to Firebase for customer maps.
# FIREBASE_DATABASE_URL=https://aquaboom-3bdc0-default-rtdb.asia-southeast1.firebasedatabase.app

# ==================== CLOUDINARY ====================
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ==================== GOOGLE MAPS (optional — delivery push map thumbnails) ====================
# Server-side Static Maps for FCM notification imageUrl. Prefer a key restricted by HTTP referrer/IP.
# GOOGLE_STATIC_MAPS_API_KEY=your_key_with_static_maps_api_enabled
# Or reuse one key for both Maps + Static Maps + Directions API (in-app driving routes):
# GOOGLE_MAPS_API_KEY=your_key
# Enable “Directions API” in Google Cloud for the same project. Optional override:
# GOOGLE_DIRECTIONS_API_KEY=...

# ==================== CLIENT (CORS + Socket.IO) ====================
# Comma-separated. Use your computer's LAN IP + Metro (8081) when testing on a physical phone with Expo.
# Native Android/iOS builds often send no Origin header (still allowed). NODE_ENV=development allows any origin.
# Keep this roughly aligned with customer-app app.json → expo.extra.apiLanHost (that value is the API host, not Metro).
CLIENT_URL=http://localhost:8081,http://127.0.0.1:8081

# ==================== OTP ====================
OTP_EXPIRY_MINUTES=10

# ==================== PASSWORD RESET EMAIL (RESEND API) ====================
# Required for forgot-password reset code email delivery.
PASSWORD_RESET_CODE_EXPIRY_MINUTES=10
# https://resend.com/ → create API key + verified sender domain/email
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxx
RESEND_FROM=AquaBoom <onboarding@resend.dev>
# Optional timeout (ms) for API call
# RESEND_TIMEOUT_MS=18000

# ==================== DELIVERY ====================
FREE_DELIVERY_THRESHOLD=299
DELIVERY_CHARGE=30
DEFAULT_ESTIMATED_DELIVERY_MINUTES=45